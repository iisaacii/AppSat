FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PATH=/opt/easysat-venv/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    B3_BROWSER_EXECUTABLE_PATH=/ms-playwright/chromium-1223/chrome-linux64/chrome

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && python3 -m venv /opt/easysat-venv \
    && rm -rf /var/lib/apt/lists/*

COPY deployment/worker/package.json deployment/worker/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
RUN npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.cache

COPY requirements-b3-browseruse.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-b3-browseruse.txt

COPY src ./src
COPY compiler_GPT ./compiler_GPT
COPY data/portal-url-directory.json data/portal-url-directory-hashmap.json ./data/

RUN mkdir -p \
      /app/artifacts \
      /app/data/portal-outcome-memory \
      /app/data/portal-template-candidates \
    && chown -R node:node \
      /app/artifacts \
      /app/data/portal-outcome-memory \
      /app/data/portal-template-candidates

USER node

CMD ["node", "src/index.mjs", "--watch", "--store=firestore", "--worker-lane=portal", "--worker-concurrency=1"]
