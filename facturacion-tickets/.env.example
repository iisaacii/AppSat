NODE_ENV=development
BILLING_JOB_STORE=mock
OCR_ENGINE=mock
PORTAL_RUNNER_MODE=mock
BILLING_API_PORT=8080
BILLING_API_ALLOWED_ORIGINS=http://127.0.0.1:52123,http://localhost:52123
BILLING_API_BODY_LIMIT_BYTES=65536
BILLING_API_RATE_LIMIT_PER_MINUTE=120

# Configura las credenciales en el entorno de ejecucion, nunca en este archivo.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIRESTORE_ROOT_COLLECTION=AppSat
FIRESTORE_ROOT_DOCUMENT=app

HEADLESS=true
CONTAINER_HEADLESS=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
CFDI_STORAGE_MODE=mock
CFDI_STORAGE_PREFIX=billing-lab/cfdis

# Usa Redis en despliegues con varios workers.
REDIS_URL=redis://127.0.0.1:6379
BILLING_DISPATCH_MODE=poll
BILLING_QUEUE_PREFIX=appsat:billing
PORTAL_RATE_LIMIT_BACKEND=local

# Conservar la limpieza en simulacion hasta revisarla.
RETENTION_ACTIONABLE_JOB_DAYS=5
RETENTION_PURGE_ABANDONED_JOBS=false
